{
	"compilerOptions": {
		"target": "es2019",
		"lib": [
			"ES2019",
			"ES2020.String"
		],
		"module": "Node16",
		"moduleResolution": "Node16",
		"sourceMap": true,
		"strict": true,
		"skipLibCheck": true,
		"types": [
			"node"
		],
		"outDir": "runtimeout",
		"rootDir": "src"
	},
	"include": [
		"src/runtime"
	],
	"exclude": [
		"node_modules",
		".vscode-test"
	]
}
